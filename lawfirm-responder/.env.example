# 运行模式：shadow（影子模式，只判断不发言）| live（自动发言）
RESPONDER_MODE=shadow

# 企业微信回调配置（企微后台「接收消息」页面获取）
RESPONDER_WECOM_CORP_ID=
RESPONDER_WECOM_TOKEN=
RESPONDER_WECOM_ENCODING_AES_KEY=
RESPONDER_WECOM_CORP_SECRET=
RESPONDER_WECOM_AGENT_ID=

# 微信客服（免费全自动进线通道）：后台 → 客户与上下游 → 微信客服 → API 处的 Secret
RESPONDER_WECOM_KF_SECRET=

# 智能机器人（群聊 @ 触发）：后台 → 应用管理 → 智能机器人，**独立**于应用的那套凭据
RESPONDER_WECOM_BOT_TOKEN=
RESPONDER_WECOM_BOT_AES_KEY=
# 群聊没有「接待人」可查，线索简报的默认接收人只能显式指定
RESPONDER_BOT_DEFAULT_NOTIFY_USERID=
# 客服会话自动建档时的默认承办律师姓氏 / 案件类型（话术点名用，可留空）
RESPONDER_KF_DEFAULT_LAWYER_NAME=
RESPONDER_KF_DEFAULT_CASE_TYPE=
# 客户扫码进入客服会话即主动打招呼（不等他先开口）。
# 空窗口是最大的流失点：抖音后台实测 416 人进私信只有 90 人开口。
# 若企微后台已配了自带欢迎语，把这项设为 false 以免两句撞在一起。
# 进线即问候。**默认关**：企微后台「微信客服 → 欢迎语」已经配了一条，
# 我们再发一条，客户连着看到两句招呼——那恰恰是「一看就知道是机器人」
# 最典型的样子。后台没配欢迎语的部署方式再打开。
RESPONDER_KF_WELCOME_ON_ENTER=false

# 分条发送的间隔（秒）。「一股脑发出来」是客户认出机器人最直接的一条线索，
# 比措辞本身更明显——真人打一句话要想一下、要打字。首条不等（首响是北极星指标）。
RESPONDER_SPLIT_DELAY_SECONDS=3.0

# ---- 下面这几项律所自己会想改，列出来免得去翻代码 ----
# 面谈邀约里点名的资历。**留空即不提**——律协禁止虚假宣传，这句必须是真的。
RESPONDER_OFFICE_SENIOR_TITLE=主任律师
# 律所书面授权、可以对客说出口的「免费」原话，`|` 分隔。
# 话术从这里取（唯一真相来源），出口闸门也拿它比对——两边必须是同一份。
# 改这一项等于改一次对外承诺，须律所方本人确认。
RESPONDER_APPROVED_CLAIMS=免费咨询|咨询是免费的|首次咨询免费
# 所址：邀约话术里报全，让人觉得是实体所。留空则只约时间不报地址。
RESPONDER_OFFICE_ADDRESS=上海市松江区九峰路88号平高广场11楼

# ---- 数据留存（《个人信息保护法》第 19 条）----
# 0 = 不清理（当前默认，刻意的）。保留多久是律所的业务决策——要兼顾利益冲突
# 检查、回访、诉讼时效——不该由写代码的人替他们定。填了就会每天清一次，
# 已成交客户的记录一律不动。**不可逆**：删掉的会话在控制台里也查不到了。
RESPONDER_RETENTION_DAYS=0
# 消息原文可以比线索档案先删（原文最敏感，过期后对业务也没用）。留 0 跟随上面。
RESPONDER_RETENTION_DAYS_MESSAGES=0

# nginx 反代下必须配 1，否则登录锁定会从「按 IP 分桶」塌成「全世界一个桶」。
# `scripts/enable-https.sh` 会自动写这一行。
RESPONDER_TRUSTED_PROXY_HOPS=0

# ---- 抖音企业号私信（open.douyin.com，需蓝V认证企业号 + 权限过审）
# 接入步骤见 docs/douyin.md。凭据到手后跑 scripts/douyin_smoke.py 自检。
RESPONDER_DOUYIN_CLIENT_KEY=
RESPONDER_DOUYIN_CLIENT_SECRET=
# 回调签名校验 Token（在开发者后台配置回调地址时自己设一串）。
# 公网部署必填：留空 = 不校验签名，任何人都能伪造客户消息灌进来。
RESPONDER_DOUYIN_CALLBACK_TOKEN=
# 发送私信的接口地址。抖音文档站在部署环境不可达，故做成配置项：
# 跑 `python scripts/douyin_smoke.py --probe` 试出正确路径后填这里，不用改代码。
RESPONDER_DOUYIN_SEND_URL=https://open.douyin.com/im/send/msg/
# ⚠️ 下面三项是平台硬限制，不是我们的策略，**不要往大了调**：
# 客户发言后 24 小时内才允许回复；同一窗口内客户下次开口前最多 6 条（分条后的真实条数）
RESPONDER_DOUYIN_REPLY_WINDOW_SECONDS=86400
RESPONDER_DOUYIN_MAX_PARTS_PER_WINDOW=6
# 分条上限在抖音要收敛：拆 3 条的话两轮就打满配额，要电话那句反而发不出去
RESPONDER_DOUYIN_SPLIT_MAX_PARTS=2
RESPONDER_DOUYIN_WELCOME_ON_ENTER=true
# 抖音侧没有「接待人」可查，线索简报的接收人只能显式指定
RESPONDER_DOUYIN_DEFAULT_NOTIFY_USERID=

# ---- 收口：聊到一定程度主动要电话 + 邀约到所面谈
# 第几条客户发言之后开口要（0 = 关掉这个动作）
RESPONDER_ASK_CONTACT_AFTER_MESSAGES=3
# 邀约话术里报的所名与地址（地址留空则只约时间、不报地址）
RESPONDER_OFFICE_NAME=上海松沪律师事务所
RESPONDER_OFFICE_ADDRESS=上海市松江区九峰路88号平高广场11楼

# LLM 供应商（不配置任何 key 时判断引擎走纯规则、回复走模板路径）
# deepseek | anthropic | auto（auto = 谁的 key 在就用谁，deepseek 优先）
# 谁来处理客户的咨询原文。**写死一个，不要用 auto。**
# 客户在这里讲的是欠薪、离婚、伤情、家人有没有被拘留，每条原文都会发给模型。
# auto 的意思是「哪个 key 在就发给谁」——环境里多一个 ANTHROPIC_API_KEY，
# 数据就静默地改走境外服务商，而那在《个人信息保护法》上是「个人信息出境」，
# 要求完全不同。换处理者是律所的合规决定，必须显式写出来。
RESPONDER_LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
RESPONDER_DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
RESPONDER_CLAUDE_MODEL=claude-opus-4-8

# AI 补位等待时长（秒）：人工无回复超过该时长 AI 才出手 [待定：按群/时段配置]
RESPONDER_WAIT_SECONDS_DAY=150
RESPONDER_WAIT_SECONDS_NIGHT=60
# 夜间时段定义（本地时间小时，含头不含尾）
RESPONDER_NIGHT_START_HOUR=21
RESPONDER_NIGHT_END_HOUR=8

# 人工接管静默时长（秒）：律师在群里发言后，AI 对该群保持沉默的时长
RESPONDER_TAKEOVER_SECONDS=1800

# 紧急提醒升级：第一责任人未读多少秒后升级到第二责任人
RESPONDER_ESCALATION_SECONDS=600

# ---- 控制台与账号
# 公网部署必填（deploy.sh 会自动生成并打印）。为空时仅允许本机访问。
RESPONDER_ADMIN_TOKEN=
# 群档案没配承办律师时的兜底提醒接收人（企微 userid）
RESPONDER_DEFAULT_NOTIFY_USERID=
# 律师登录链接的对外地址，如 https://ai.example.com；留空则按请求 Host 推断
RESPONDER_PUBLIC_BASE_URL=

# ---- 分案与优先级（规则见 docs/lead-routing.md）
# 下列阈值属于「判断阈值」，调整须人工确认（见 CLAUDE.md 自主循环边界）
RESPONDER_PRIORITY_P0_THRESHOLD=60
RESPONDER_PRIORITY_P1_THRESHOLD=30
# P0 超过该秒数仍未标记「已联系」→ 督办并抄送第二责任人
RESPONDER_LEAD_P0_SLA_SECONDS=3600
# 紧急线索强推交接单的冷却时间：客户连发几条急消息，律师只该收一张单
RESPONDER_LEAD_FORCE_COOLDOWN_SECONDS=600
# 会话安静多久后为「有意向但未触发即时通知」的咨询补一份简报
RESPONDER_LEAD_IDLE_SECONDS=900
# 同一客户两次咨询的分隔阈值：超过此空档视为另一次咨询
RESPONDER_LEAD_SESSION_GAP_SECONDS=7200

# 数据库路径
RESPONDER_DB_PATH=responder.db

# API 服务
RESPONDER_API_HOST=127.0.0.1
RESPONDER_API_PORT=8020

# ---- 自动升级
# 服务器自己定时看远端分支有没有新提交，有就拉下来重启。
# 运维侧不一定够得着这台服务器（网络策略/没有 SSH），但服务器够得着 GitHub。
# 设为 false 则回到「控制台点按钮」的人工升级。
RESPONDER_AUTO_UPDATE_ENABLED=true
RESPONDER_AUTO_UPDATE_INTERVAL_SECONDS=300
# 客户刚说过话就不重启：重启会丢掉内存队列里没处理完的消息。
# 升级晚五分钟没关系，客户的消息掉了有关系。
RESPONDER_AUTO_UPDATE_QUIET_SECONDS=120

# ---- 会话转接（见 docs/kf-handoff.md）
# 强意愿线索直接把微信客服会话转给分到的律师，省掉「打电话」这一最脆的环节。
# 前置条件：律师必须在 kf.weixin.qq.com 被加为该客服账号的「接待人员」，
# 否则企微直接拒绝转接。控制台「状态」页有一键自检。
RESPONDER_HANDOFF_ENABLED=true
# 哪些优先级触发转接。紧急线索无论优先级一律转。
# 别放宽到 P1/P2——一周 416 人进私信，全转过去律师什么也别干了。
RESPONDER_HANDOFF_PRIORITIES=P0
# 转接后律师迟迟不接手 → 把客户收回给 AI 继续兜着。
RESPONDER_HANDOFF_RECLAIM_SECONDS=1800
# 接口路径。企微文档站在部署环境不可达，故做成配置项：
# 控制台自检报「接口探测失败」时改这里即可，不必改代码重新部署。
RESPONDER_KF_TRANS_PATH=kf/service_state/trans
RESPONDER_KF_STATE_PATH=kf/service_state/get
