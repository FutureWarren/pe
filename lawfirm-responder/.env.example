# 运行模式：shadow（影子模式，只判断不发言）| live（自动发言）
RESPONDER_MODE=shadow

# 企业微信回调配置（企微后台「接收消息」页面获取）
RESPONDER_WECOM_CORP_ID=
RESPONDER_WECOM_TOKEN=
RESPONDER_WECOM_ENCODING_AES_KEY=
RESPONDER_WECOM_CORP_SECRET=
RESPONDER_WECOM_AGENT_ID=

# Claude API（可选：不配置时判断引擎走纯规则、回复走模板路径）
ANTHROPIC_API_KEY=
RESPONDER_CLAUDE_MODEL=claude-opus-4-8

# AI 补位等待时长（秒）：人工无回复超过该时长 AI 才出手 [待定：按群/时段配置]
RESPONDER_WAIT_SECONDS_DAY=150
RESPONDER_WAIT_SECONDS_NIGHT=60
# 夜间时段定义（本地时间小时，含头不含尾）
RESPONDER_NIGHT_START_HOUR=21
RESPONDER_NIGHT_END_HOUR=8

# 人工接管静默时长（秒）：律师在群里发言后，AI 对该群保持沉默的时长
RESPONDER_TAKEOVER_SECONDS=1800

# 紧急提醒升级：第一责任人未读多少秒后升级到第二责任人
RESPONDER_ESCALATION_SECONDS=600

# 数据库路径
RESPONDER_DB_PATH=responder.db

# API 服务
RESPONDER_API_HOST=127.0.0.1
RESPONDER_API_PORT=8020
