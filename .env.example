# Optional Gemini extraction settings.
ANGELIC_DEFAULT_EXTRACTION_BACKEND=deterministic
ANGELIC_GEMINI_API_KEY=
ANGELIC_GEMINI_MODEL=gemini-2.5-pro

# Local runtime settings.
ANGELIC_ENV=local
ANGELIC_OUTPUT_DIR=outputs
ANGELIC_DEFAULT_DATA_ROOM=samples/data_room
ANGELIC_API_HOST=127.0.0.1
ANGELIC_API_PORT=8011
